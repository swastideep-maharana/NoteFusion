generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                  String   @id @default(cuid()) @map("_id")
  email               String   @unique
  password            String
  username            String?
  userImage           String?
  verificationCode    String?
  verified            Boolean  @default(false)
  verificationExipiry DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
